# CYVANTA Public Document Root Apache Configuration

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct directory indexing
    Options -Indexes

    # Allow clean routing for index fallback
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>
